<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>TALXIS.TestKit.Bindings</id>
    <version>1.0.5</version>
    <authors>NETWORG</authors>
    <owners>NETWORG</owners>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <description>A Reqnroll bindings library for Power Apps.</description>
    <copyright>Copyright © 2025</copyright>
    <tags>powerapps reqnroll bindings automated-testing testing</tags>
    <repository type="git" url="https://github.com/TALXIS/tools-testkit-ui.git" />
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="FluentAssertions" version="5.10.3" />
        <dependency id="Microsoft.CrmSdk.CoreAssemblies" version="9.0.2.29" />
        <dependency id="Microsoft.Extensions.Configuration" version="8.0.0" />
        <dependency id="Microsoft.Extensions.Configuration.Binder" version="8.0.2" />
        <dependency id="Microsoft.Extensions.Configuration.EnvironmentVariables" version="8.0.0" />
        <dependency id="Microsoft.Extensions.Configuration.Json" version="8.0.0" />
        <dependency id="Microsoft.Extensions.Configuration.UserSecrets" version="8.0.0" />
        <dependency id="Microsoft.Extensions.DependencyInjection" version="8.0.0" />
        <dependency id="Microsoft.Identity.Client" version="4.71.1" />
        <dependency id="Microsoft.PowerPlatform.Dataverse.Client" version="1.2.5" />
        <dependency id="Newtonsoft.Json" version="13.0.3" />
        <dependency id="Polly" version="7.2.2" />
        <dependency id="Reqnroll" version="2.2.1" />
        <dependency id="Selenium.Support" version="4.0.0" />
        <dependency id="Selenium.WebDriver" version="4.0.0" />
        <dependency id="TALXIS.TestKit.Selectors" version="1.0.5" />
        <dependency id="TALXIS.TestKit.Selectors.Browser" version="1.0.3" />
        <dependency id="WebDriverManager" version="2.17.5" />
        <dependency id="YamlDotNet" version="9.1.0" />
      </group>
    </dependencies>
  </metadata>

  <files>
    <file src="targets\TALXIS.TestKit.Bindings.targets" target="build\TALXIS.TestKit.Bindings.targets" />

    <file src="bin\lib\driver.js" target="build\driver.js" />

    <file src="bin\lib\TALXIS.TestKit.Bindings.MSBuild\**\*" target="build\TALXIS.TestKit.Bindings.MSBuild" />

    <file src="icon.png" target="" />
  </files>
</package>
